{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true,
    "types": ["vite/client"],
    "paths": { "@shared/*": ["./src/shared/*"], "@/*": ["./src/renderer/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/index.d.ts", "tests/renderer/**/*"]
}
